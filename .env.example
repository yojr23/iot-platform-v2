# Orchestracion local para Docker Compose.
# Backend real: ver `back/.env.example`
# Frontend real: ver `front/.env.example`

BACK_PORT=8000
FRONT_PORT=5173
MYSQL_PORT=3306
REDIS_PORT=6379
COMPOSE_PROJECT_NAME=iotplatformv2

DB_CONNECTION=mysql
DB_DATABASE=iot_platform
DB_USERNAME=iot_user
DB_PASSWORD=iot_password
DB_ROOT_PASSWORD=root_password

CACHE_STORE=database
SESSION_DRIVER=database
QUEUE_CONNECTION=database
INGESTION_SERVICE_TOKEN=
INGESTION_RAW_EVENTS_STREAM=iot.raw-events
INGESTION_RAW_EVENTS_MAXLEN=500000
# Optional: trim entries older than this many milliseconds (0 = MAXLEN only)
# INGESTION_RAW_EVENTS_MIN_AGE_MS=86400000
DOMAIN_EVENTS_STREAM=iot.domain-events
DOMAIN_EVENTS_MAXLEN=500000
# Optional: trim domain event entries older than this many milliseconds (0 = MAXLEN only)
# DOMAIN_EVENTS_MIN_AGE_MS=86400000
CDC_STREAM_MAXLEN=500000
DLQ_MAXLEN=1000000

VITE_PUSHER_APP_KEY=
VITE_PUSHER_APP_CLUSTER=
VITE_PUSHER_FORCE_TLS=true
VITE_PUSHER_HOST=
VITE_PUSHER_PORT=
VITE_PUSHER_SCHEME=https

# --- Portal desde otros PCs del lab (LAN) ---------------------------------------------------
# Sin definir nada, el portal solo funciona en localhost. Para abrirlo desde otro PC, pon la IP
# LAN de ESTE servidor (ej. LAN_IP=192.168.1.20) en estas variables (docker compose NO expande
# LAN_IP solo: escribe la IP en cada una). Luego `docker compose up -d back reverb front`.
# LAN_IP=192.168.1.20
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://<LAN_IP>:5173
# SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:8000,<LAN_IP>:5173,<LAN_IP>:8000
# REVERB_ALLOWED_ORIGINS=localhost,127.0.0.1,<LAN_IP>   # Reverb compara solo el HOST
# VITE_API_BASE_URL=http://<LAN_IP>:8000/api
# VITE_PUSHER_HOST=<LAN_IP>   # (arriba, reemplaza 127.0.0.1); puerto 8080, scheme http, FORCE_TLS=false
