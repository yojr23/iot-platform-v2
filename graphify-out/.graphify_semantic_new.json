      "source_location": "line:244",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Golden rules: NO polling, NO polling fallback, NO hybrid realtime, NO periodic state discovery, NO browser→Redis, NO synchronous RPC disguised as events."
    },
