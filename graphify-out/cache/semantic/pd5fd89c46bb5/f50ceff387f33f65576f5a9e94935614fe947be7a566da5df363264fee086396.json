{"nodes": [{"id": "audit_md", "label": "audit.md \u2014 architecture audit and implementation plan", "file_type": "document", "source_file": "audit.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_outbox_cdc_relay", "label": "Transactional outbox + binlog-driven CDC relay", "file_type": "rationale", "source_file": "audit.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Recommended over best-effort dual write (DB insert then XADD) and over SQL-polling outbox, because it satisfies durable delivery while respecting the strict no-periodic-state-discovery-polling constraint; requires a deployment feasibility gate (binlog connector/sink verification) before rollout."}, {"id": "concept_echo_registry_ownership", "label": "Echo channel registry / reference-counted subscription ownership", "file_type": "rationale", "source_file": "audit.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Current useSensorRealtime/useAlertsRealtime call leaveChannel which tears down the entire shared channel for all consumers; proposed fix keeps one Echo connection per tab but reference-counts individual listener subscriptions so one consumer unsubscribing doesn't break others."}, {"id": "concept_recovery_protocol_cursor_replay", "label": "Cursor/replay + snapshot recovery protocol", "file_type": "rationale", "source_file": "audit.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Proposed WebSocket-only recovery: buffer live events during snapshot boundary, send bounded resume command with scoped cursor, replay authorized events with recovery-complete watermark, or fall back to DB snapshot + catch-up if cursor expired; polling explicitly excluded as an acceptable recovery mechanism, must precede timer deletion (G0-P10 rollout gates)."}, {"id": "concept_no_polling_gate", "label": "No-polling gate (definition of done)", "file_type": "rationale", "source_file": "audit.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Verified via source inspection plus browser network traces, transport restriction checks and backend relay/worker inspection \u2014 a passing build or simulated handler test alone is explicitly insufficient evidence."}, {"id": "code_front_src_components_layout_applayout", "label": "AppLayout.vue", "file_type": "code", "source_file": "audit.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "code_front_src_components_dashboard_activealertscard", "label": "ActiveAlertsCard.vue", "file_type": "code", "source_file": "audit.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "code_front_src_components_dashboard_sensormonitorboard", "label": "SensorMonitorBoard.vue", "file_type": "code", "source_file": "audit.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "code_front_src_realtime_echo", "label": "echo.js (Echo singleton)", "file_type": "code", "source_file": "audit.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "code_front_src_realtime_usealertsrealtime", "label": "useAlertsRealtime.js", "file_type": "code", "source_file": "audit.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "code_front_src_realtime_usesensorrealtime", "label": "useSensorRealtime.js", "file_type": "code", "source_file": "audit.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "code_front_src_components_layout_navbar", "label": "NavB