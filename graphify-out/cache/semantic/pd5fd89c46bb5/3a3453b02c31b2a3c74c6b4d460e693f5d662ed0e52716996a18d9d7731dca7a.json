{"nodes": [{"id": "claude_md_root", "label": "CLAUDE.md (repo guidance)", "file_type": "document", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_ingestion_paths_dual", "label": "Two parallel ingestion paths (legacy + raw)", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Legacy path persists SensorReading directly and evaluates alerts synchronously via observers; newer raw ingestion path XADDs to Redis Streams iot.raw-events but has no consumer yet, so readings published there do not automatically become SensorReading rows. Kept unmerged deliberately pending consumer implementation."}, {"id": "concept_observer_event_side_effect_convention", "label": "Observer/Event side-effect convention", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Business-rule side effects (alert evaluation, email, broadcast) belong in Observers/Listeners, not controllers, to keep controllers thin and side effects consistent across ingestion paths."}, {"id": "concept_bulk_update_no_observer", "label": "Eloquent::update() bulk calls do not fire observers", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Laravel mass updates bypass individual model events, so resolveAll()-style bulk resolution does not trigger AlertObserver; alert resolution/device status therefore not fully event-driven."}, {"id": "concept_frontend_realtime_model", "label": "Frontend realtime model (shared Echo instance)", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One Echo/Pusher-JS connection is meant to be reused across the SPA (not one per component) to avoid duplicate socket overhead; polling timers exist alongside it as legacy fallback duplicating the same state."}, {"id": "concept_polling_duplication_state", "label": "Polling timers duplicating realtime state", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "AppLayout.vue (10s), ActiveAlertsCard.vue (5s), SensorMonitorBoard.vue (~2s) poll REST endpoints that duplicate what WebSocket events already deliver; targeted for removal only after recovery protocol exists (audit.md TASK-008/009)."}, {"id": "concept_state_ownership_target", "label": "State ownership target: WS -> Pinia -> components", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Not yet implemented; goal is a single domain-projection state path per screen instead of a fourth parallel component-local polling path."}, {"id": "code_back_app_services_ingestion_rawsensoreventpublisher", "label": "RawSensorEventPublisher", "file_type": "code", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "repo_iot_platform_v2", "label": "IoT Platform v2 monorepo", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "repo_back_dir", "label": "back/ (Laravel 12 API)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "repo_front_dir", "label": "front/ (Vue 3 + Vite + Pinia SPA)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, 