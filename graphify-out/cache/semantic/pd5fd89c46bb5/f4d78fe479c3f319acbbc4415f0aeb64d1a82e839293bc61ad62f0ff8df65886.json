{"nodes": [{"id": "memory_01_architecture_decisions_adr_001_monorepo", "label": "ADR-001: Keep A Monorepo Initially", "file_type": "rationale", "source_file": "memory/01-architecture-decisions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keeping /front and /back in one repo supports gradual migration and avoids splitting the project before a clear API boundary exists."}, {"id": "memory_01_architecture_decisions_adr_002_rest_api_backend", "label": "ADR-002: Backend As REST API + Broadcasting", "file_type": "rationale", "source_file": "memory/01-architecture-decisions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Allows the frontend to run independently and prepares the backend for later modularization or service extraction."}, {"id": "memory_01_architecture_decisions_adr_003_no_blade_move", "label": "ADR-003: Do Not Move Blade Directly To /front", "file_type": "rationale", "source_file": "memory/01-architecture-decisions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Blade depends on Laravel runtime behavior, helpers, routes, session, CSRF, auth, injected variables, and backend-side logic, so it cannot function as standalone frontend code."}, {"id": "memory_01_architecture_decisions_adr_004_incremental_migration", "label": "ADR-004: Incremental Migration", "file_type": "rationale", "source_file": "memory/01-architecture-decisions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Complete and normalize APIs first, then create the frontend, then retire Blade gradually to reduce the risk of breaking existing behavior."}, {"id": "memory_01_architecture_decisions_adr_005_env_separation", "label": "ADR-005: Separate Environment Variables", "file_type": "rationale", "source_file": "memory/01-architecture-decisions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Anything bundled into the frontend can be exposed to users, so frontend may only use public VITE_* variables while backend keeps secrets."}, {"id": "memory_01_architecture_decisions_adr_006_api_only_communication", "label": "ADR-006: API-Only Frontend Communication", "file_type": "rationale", "source_file": "memory/01-architecture-decisions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The frontend must not access the database, internal files, Laravel models, service classes, or backend implementation details directly."}, {"id": "memory_01_architecture_decisions_adr_007_docker_per_service", "label": "ADR-007: Docker Per Service", "file_type": "rationale", "source_file": "memory/01-architecture-decisions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Independent Dockerfiles per service prepare the project for modular deployment and later backend service division."}, {"id": "memory_01_architecture_decisions_adr_008_frontend_framework", "label": "ADR-008: Frontend Framework (Vue 3 + Bootstrap 5, proposed)", "file_type": "rationale", "source_file": "memory/01-architecture-decisions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No Vue/React was detected in the initial audit; adopting Vue must be treated as a real Blade-to-SPA migration, not a file move."}, {"id": "memory_01_architecture_decisions_adr_009_sanctum_bearer_auth", "label": "ADR-009: SPA Auth Uses Sanctum Bearer Tokens Initially", "file_type": "rationale", "source_file": "memory/01-architecture-decisions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Continuing the existing Sanctum Bearer token path completes Phase 1 with smaller risk than switching immediately to cookie-based Sanctum SPA auth, which needs coordinated CORS/CSRF/cookie-domain changes; frontend token storage strategy must be revisited in Phase 3 to reduce XSS impact."}], "edges": [{"source": "memory_00_project_context_migration_principle", "target": "memory_01_architecture_decisions_adr_004_incremental_migration", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "memory/01-architecture-decisions.md", "source_location": null, "weight": 1.0}, {"source": "memory_01_architecture_decisions_adr_001_monorepo", "target": "memory_00_project_context_refactor_goal", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "memory/01-architecture-decisions.md", "source_location": null, "weight": 1.0}, {"source": "memory_01_architecture_decisions_adr_002_rest_api_backend", "target": "memory_00_project_context_refactor_goal", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "memory/01-architecture-decisions.md", "source_location": null, "weight": 1.0}, {"source": "memory_01_architecture_decisions_adr_003_no_blade_move", "target": "memory_02_current_audit_blade", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "memory/01-architecture-decisions.md", "source_location": null, "weight": 1.0}, {"source": "memory_01_architecture_decisions_adr_005_env_separation", "target": "memory_01_architecture_decisions_adr_006_api_only_communication", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "memory/01-architecture-decisions.md", "source_location": null, "weight": 1.0}, {"source": "memory_01_architecture_decisions_adr_009_sanctum_bearer_auth", "target": "memory_02_current_audit_sanctum", "relation": "references", "confidence": "EXTRACTED", 