MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_TOPIC=iot/+/readings
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=iot-platform-v2-ingestion
MQTT_QOS=1
# Persistent broker session: keep false so the broker queues QoS-1 messages for this client id
# while the ingestion subscriber is offline (no loss during a subscriber-down window).
MQTT_CLEAN_SESSION=false

BACKEND_BASE_URL=http://localhost:8000
BACKEND_INGESTION_TOKEN=
BACKEND_TIMEOUT_SECONDS=10

# SQLite edge spool and independent backend-delivery retry worker.
INGESTION_SPOOL_PATH=/data/ingestion-spool.sqlite3
INGESTION_RETRY_BASE_SECONDS=1
INGESTION_RETRY_MAX_SECONDS=60
INGESTION_DELIVERY_BATCH_SIZE=50
INGESTION_MAX_DELIVERY_ATTEMPTS=20

LOG_LEVEL=INFO
INGESTION_MODE=simulate
