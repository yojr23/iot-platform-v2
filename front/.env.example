VITE_API_BASE_URL=http://localhost:8000/api

# Realtime transport. Echo uses the Pusher protocol, which Laravel Reverb speaks natively, so
# these VITE_PUSHER_* vars point at the self-hosted Reverb server (not pusher.com).
# For local Reverb: key = REVERB_APP_KEY, host = 127.0.0.1, port = 8080, scheme = http (no TLS).
# Leave APP_CLUSTER empty when a host is set. For managed Pusher instead, fill cluster + real host.
VITE_PUSHER_APP_KEY=
VITE_PUSHER_APP_CLUSTER=
VITE_PUSHER_FORCE_TLS=false
VITE_PUSHER_HOST=127.0.0.1
VITE_PUSHER_PORT=8080
VITE_PUSHER_SCHEME=http
